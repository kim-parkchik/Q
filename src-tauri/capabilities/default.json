{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Q の窓で使えること（会社ファイル・ファイルを選ぶ窓・書類フォルダの Q フォルダの中の読み書き・祝日の CSV（内閣府）の取り込み・Q の GitHub のページと国税庁の法人番号公表サイトの法人番号のページを開く）。ファイルを選ぶ窓で選んだファイルは、窓が読み書きを許す。書類フォルダの Q の名前は src/constants/appConfig.ts の APP_DIR_NAME と、法人番号のページは HOUJIN_BANGOU_PAGE_URL と同じにする。郵便番号の住所は Q の中のデータ（public/zipcode）で引くので、通信しない",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-remove",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOCUMENT/Q" },
        { "path": "$DOCUMENT/Q/**" }
      ]
    },
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://www8.cao.go.jp/chosei/shukujitsu/syukujitsu.csv" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/kim-parkchik/Q/*" },
        { "url": "https://www.houjin-bangou.nta.go.jp/henkorireki-johoto.html*" }
      ]
    }
  ]
}
