{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Q の窓で使えること（会社ファイル・ファイルを選ぶ窓・書類フォルダの Q フォルダの中の読み書き・決まった3つの先への通信・Q の GitHub のページを開く）。ファイルを選ぶ窓で選んだファイルは、窓が読み書きを許す。書類フォルダの Q の名前は src/constants/appConfig.ts の APP_DIR_NAME と同じにする",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "dialog:default",
    "sql:allow-load",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-close",
    "fs:allow-copy-file",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-remove",
    "fs:allow-write-file",
    "fs:allow-write-text-file",
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DOCUMENT/Q" },
        { "path": "$DOCUMENT/Q/**" }
      ]
    },
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "allow": [
        { "url": "https://www8.cao.go.jp/chosei/shukujitsu/syukujitsu.csv" },
        { "url": "https://www.houjin-bangou.nta.go.jp/**" },
        { "url": "https://zipcloud.ibsnet.co.jp/**" }
      ]
    },
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://github.com/kim-parkchik/Q/*" }
      ]
    }
  ]
}
