{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "TimeQard の窓で使えること（記録のファイル・ファイルを選ぶ窓・選んだファイルの読み書き・画面いっぱい）",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "sql:default",
    "sql:allow-execute",
    "sql:allow-select",
    "sql:allow-load",
    "dialog:default",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-ask",
    "fs:allow-read-text-file",
    "fs:allow-write-file"
  ]
}
